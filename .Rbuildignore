# Nix
^nix-shell-root$
^default\.R$
^default\.nix$
^default\.sh$
^default-ci\.nix$
^default_ci\.nix$
^package\.nix$
^push_to_cachix\.sh$

# Targets pipeline
^_targets\.R$
^_targets$
^_targets\.R\.backup$
^_targets\.yaml$

# Data and output directories
^data$
^docs$
^plans$
^result$
^results$

# RStudio
^.*\.Rproj$
^\.Rproj\.user$

# Shinylive / Quarto build artifacts
^vignettes/dashboard_shinylive.*
^vignettes/_extensions$
^vignettes/shinylive-sw\.js$
^vignettes/BUILD_SHINYLIVE\.md$
^vignettes/SHINYLIVE_QUICKSTART\.md$
^vignettes/build_shinylive\.sh$
^\.quarto$
^_quarto\.yml$
^_extensions$

# pkgdown
^_pkgdown\.yml$
^pkgdown$

# Hidden directories and files
^\.claude$
^\.github$
^\.lintr$
^vignettes/\.quarto$

# LICENSE (included via License field)
^LICENSE\.md$
^LICENSE\.content\.md$
